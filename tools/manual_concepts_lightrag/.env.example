# =============================================================================
# manual_concepts_lightrag 子项目配置示例
# 复制为 .env 并按需填入真实值（真实 .env 不应提交密钥）
# 存储：默认文件后端（不设 LIGHTRAG_*_STORAGE → JsonKV / NanoVectorDB / NetworkX）
# =============================================================================

# ---- LLM（OpenAI 兼容；填内网 vLLM / SiliconFlow / OpenAI 均可）----
LLM_BINDING=openai
LLM_MODEL=your-llm-model
LLM_BINDING_HOST=http://your-llm-host:port/v1
LLM_BINDING_API_KEY=no-api-key

# ---- Embedding（OpenAI 兼容接口）----
# EMBEDDING_BINDING 必须显式设为 openai，否则 server 默认 ollama（与 vLLM OpenAI 接口不兼容）
EMBEDDING_BINDING=openai
EMBEDDING_MODEL=your-embedding-model
EMBEDDING_DIM=1024
EMBEDDING_BINDING_HOST=http://your-embedding-host:port/v1
EMBEDDING_BINDING_API_KEY=no-api-key

# ---- Rerank（可选；不配则查询时自动跳过 rerank）----
RERANK_MODEL=your-rerank-model
RERANK_BASE_URL=http://your-rerank-host:port

# =============================================================================
# 概念检索（CONCEPT_RETRIEVAL_*，新变量，推荐使用）
# 优先级：调用方传入 > CONCEPT_RETRIEVAL_* > legacy 旧变量 > 默认值
# =============================================================================
# 是否启用概念召回（占位，便于 ai-service concept_explain 意图复用判断）
CONCEPT_RETRIEVAL_ENABLED=true
# 领域：默认 math，可扩展 industrial_training 等
CONCEPT_RETRIEVAL_DOMAIN=math
# 实体类型：默认 MANUAL_CONCEPT（旧 MANUAL_MATH_CONCEPT 已 deprecated，仅在 test HIT 判定中兼容）
CONCEPT_RETRIEVAL_ENTITY_TYPE=MANUAL_CONCEPT
# 概念 JSONL 源文件
CONCEPT_RETRIEVAL_CONFIG=/home/zj/ZengKingMorphe/ai-service/data/math_concepts/05_selective3_math_concepts_definition_blocks_with_concept_name_20260630.jsonl
# 实体白名单
CONCEPT_RETRIEVAL_WHITELIST=/home/zj/ZengKingMorphe/tools/manual_concepts_lightrag/entity_whitelist_draft.txt
# LightRAG working_dir（主路径默认目录）
CONCEPT_RETRIEVAL_LIGHTRAG_WORKING_DIR=/home/zj/ZengKingMorphe/ai-service/data/lightrag_manual_concepts
# 是否启用 LightRAG（占位，与 CONCEPT_RETRIEVAL_ENABLED 等价，便于 ai-service 复用）
ENABLE_LIGHTRAG=true
# 可选：entity extraction prompt 文件路径（覆盖 entity_types_guidance 软约束的完整 prompt）
# 注意：若指定，文件中必须包含与 entity extraction 模式（json/text）匹配的 examples 字段，
#       否则 LightRAG main 会报错。留空 = 仅用 CONCEPT_RETRIEVAL_ENTITY_TYPE 推导的 guidance。
CONCEPT_RETRIEVAL_ENTITY_TYPE_PROMPT_FILE=

# =============================================================================
# legacy 变量（仍兼容，建议逐步迁移到 CONCEPT_RETRIEVAL_*）
# =============================================================================
# CONFIG=/home/zj/ZengKingMorphe/ai-service/data/math_concepts/05_selective3_math_concepts_definition_blocks_with_concept_name_20260630.jsonl
# WORKING_DIR=/home/zj/ZengKingMorphe/ai-service/data/lightrag_manual_concepts
# ENTITY_WHITELIST=/home/zj/ZengKingMorphe/tools/manual_concepts_lightrag/entity_whitelist_draft.txt
# BATCH_SIZE=100

# ---- LightRAG Server（如使用 run_server.sh）----
HOST=0.0.0.0
PORT=9621
# 故意不设 LIGHTRAG_KV_STORAGE / LIGHTRAG_VECTOR_STORAGE / LIGHTRAG_GRAPH_STORAGE
# / LIGHTRAG_DOC_STATUS_STORAGE → 走默认文件后端，读现有 working_dir 数据

# =============================================================================
# 重要：不要在此设置 ENTITY_TYPES —— LightRAG main 已废弃该变量，
#       检测到会报错。改用 CONCEPT_RETRIEVAL_ENTITY_TYPE 或 entity_types_guidance。
# =============================================================================
