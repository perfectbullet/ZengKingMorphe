# MinerU MCP 配置
MINERU_MCP_URL=http://localhost:8001
USE_LOCAL_MINERU=true
MINERU_OUTPUT_DIR=./data/output

# vLLM Embedding 配置
VLLM_EMBEDDING_BASE_URL=http://192.168.8.233:8092/v1
VLLM_EMBEDDING_API_BASE=http://192.168.8.233:8092/v1
VLLM_EMBEDDING_MODEL=BAAI/bge-m3
VLLM_API_KEY=not-needed

# vLLM Chat 配置
VLLM_CHAT_BASE_URL=http://192.168.8.233:8092
VLLM_CHAT_API_BASE=http://192.168.8.233:8092/v1
VLLM_CHAT_MODEL=deepseek-coder:instruct

# 图片描述模型（Qwen2-VL，暂仍使用 Ollama）
QWEN_VL_MODEL=qwen2-vl:latest
QWEN_VL_BASE_URL=http://192.168.8.233:11434

# 向量存储配置（ChromaDB 远程服务）
CHROMA_HOST=192.168.8.233
CHROMA_PORT=8200
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=documents

# 索引配置
# 文本分块配置（适配 BGE-m3 的 8192 tokens）
# CHUNK_SIZE=512 字符 ≈ 1000-1500 tokens (24% 利用率)
# CHUNK_OVERLAP=150 字符 ≈ 300-375 tokens (保持上下文连续性)
CHUNK_SIZE=512
CHUNK_OVERLAP=150
TOP_K=5
SIMILARITY_THRESHOLD=0.7

# 检索配置
USE_HYBRID_RETRIEVAL=false
USE_RERANK=true
RERANK_MODEL=bge-reranker-v2-m3

# BGE Reranker 配置
RERANK_BASE_URL=http://192.168.8.233:8091
RERANK_API_BASE=http://192.168.8.233:8091/v1
RERANK_TIMEOUT=120
RERANK_CANDIDATE_MULTIPLIER=4

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=./logs/rag_sdk.log
