# ChromaDB Standalone Testing Environment Configuration
# 
# Copy this file to .env if you need to customize the test settings
# 
# Usage:
#   cp .env.chroma-test .env
#   python test_chroma_standalone.py

# ChromaDB Server Configuration
CHROMA_HOST=192.168.8.230
CHROMA_PORT=8101

# Embedding Service Configuration (Optional)
# If not set, the test will use dummy embeddings
EMBEDDING_API_URL=http://192.168.8.230:50009
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_API_KEY=

# Alternative: Use SiliconFlow or other OpenAI-compatible service
# EMBEDDING_API_URL=https://api.siliconflow.cn/v1
# EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# EMBEDDING_API_KEY=your_siliconflow_api_key

# Note: 
# - The test script will work WITHOUT a real embedding API
# - It automatically falls back to dummy embeddings for testing
# - Dummy embeddings are sufficient for testing ChromaDB connectivity
