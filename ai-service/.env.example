# ==============================================================================
# AI Service Environment Configuration
# ==============================================================================
# 本配置用于 WSL+Ubuntu22.04 开发环境
# Docker 部署时部分配置会被 docker-compose.yml 覆盖
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM Configuration
# ------------------------------------------------------------------------------
# LLM_ROUTING_MODE: 模型路由模式 (推荐使用此配置)
#   local_only  - 仅使用本地 Ollama 模型 (快速、低成本)
#   remote_only - 仅使用外部 API 模型 (高质量、需联网)
#   hybrid      - 混合模式: 根据问题复杂度自动选择模型
LLM_ROUTING_MODE=hybrid

# 配置 获取用于文本修订的 LLM 实例： siliconflow 或者 ollama
REVISE_PROVIDER=siliconflow


# Ollama Configuration (本地模型配置 - 用于简单问题)
# 当 LLM_ROUTING_MODE=local_only 或 hybrid 时生效
# 容器内部使用
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# 容器外部使用
OLLAMA_BASE_URL=http://192.168.8.230:11434
OLLAMA_MODEL=qwen2.5:14b               # 主模型 (问答生成)
OLLAMA_GRADER_MODEL=qwen2.5:14b        # 评分模型 (文档相关性评分)
OLLAMA_REVISE_MODEL=qwen2.5:14b        # 文本修饰模型

# OpenAI-style API Configuration (外部模型配置 - 用于复杂问题)
# 当 LLM_ROUTING_MODE=remote_only 或 hybrid 时生效
# 支持服务商: SiliconFlow, DeepSeek, OpenAI 等
SILICONFLOW_API_KEY=sk-ldtkmrwzqnhmzrgeednfbdulupqjjcaimcwdcwyofxmwljqi
OPENAI_API_KEY=sk-ldtkmrwzqnhmzrgeednfbdulupqjjcaimcwdcwyofxmwljqi
OPENAI_API_BASE=https://api.siliconflow.cn/v1
OPENAI_MODEL=deepseek-ai/DeepSeek-V3  # 主模型
# OPENAI_GRADER_MODEL=deepseek-ai/DeepSeek-V3       # 评分模型
OPENAI_TEMPERATURE=0.0
OPENAI_MAX_TOKENS=2000

# 混合模式配置 (仅当 LLM_ROUTING_MODE=hybrid 时生效)
# 复杂度评估机制：workflow 开始时用本地 LLM 快速评估问题复杂度 (0-10分)
# 根据复杂度分数选择模型：
#   0-6分  → 使用本地 Ollama (简单到中等复杂)
#   7-10分 → 使用外部 API   (高复杂度)
COMPLEXITY_THRESHOLD=7.0           # 复杂度阈值：>=此分数使用外部模型 (0-10)

# 特殊情况（强制使用本地模型，不受复杂度影响）：
# - 问候语 (你好、早上好等)
# - FAQ 命中 (常见问题直接回答)

# ------------------------------------------------------------------------------
# Embedding Configuration (向量化嵌入)
# ------------------------------------------------------------------------------
# SiliconFlow 嵌入配置 (备用)
SILICONFLOW_EMBEDDING_API_URL=https://api.siliconflow.cn/v1/embeddings
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_API_KEY=sk-ldtkmrwzqnhmzrgeednfbdulupqjjcaimcwdcwyofxmwljqi

# ------------------------------------------------------------------------------
# Web Search Configuration (联网搜索)
# ------------------------------------------------------------------------------
# Tavily Search API (用于实时信息检索)
# 获取地址: https://tavily.com 
TAVILY_API_KEY=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

# Web Search 功能开关
WEB_SEARCH_ENABLED=true           # 是否启用联网搜索
WEB_SEARCH_TIMEOUT=5              # 搜索超时时间 (秒)
WEB_SEARCH_MAX_RESULTS=5          # 最大返回结果数
WEB_SEARCH_ONLY_FOR_REALTIME=false  # 是否仅用于实时查询

# 实时查询检测配置
REALTIME_QUERY_ENABLED=true       # 是否启用实时查询自动检测
REALTIME_QUERY_LLM_FALLBACK_ENABLED=false  # LLM 检测失败时是否使用关键词匹配

# ------------------------------------------------------------------------------
# MongoDB Configuration (文档数据库)
# ------------------------------------------------------------------------------
# WSL+Ubuntu22.04 开发环境 - 使用认证连接
# 容器内使用
#MONGODB_URI=mongodb://funasr:funasr2026@host.docker.internal:27017/funasr?authSource=admin
# 容器外部使用
MONGODB_URI=mongodb://morphe_user:morphe_secure_2026@192.168.8.234:27017/morphe_db?authSource=morphe_db
MONGODB_DB_NAME=morphe_db
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=10

# ------------------------------------------------------------------------------
# ChromaDB Configuration (向量数据库)
# ------------------------------------------------------------------------------
# WSL+Ubuntu22.04 开发环境 - 使用 Docker Compose 端口映射
# 容器外部用
CHROMA_HOST=192.168.8.234
# 容器内部用
# CHROMA_HOST=chroma
CHROMA_PORT=8200
CHROMA_PERSIST_DIR=./chroma_db

# ------------------------------------------------------------------------------
# llama-rag-sdk Configuration (SDK 专用配置)
# ------------------------------------------------------------------------------

# ========== MinerU API 配置 ==========
# 基础 URL（SDK 会自动添加 /file_parse 后缀）
MINERU_API_URL=http://192.168.8.234:8000
MINERU_OUTPUT_DIR=./data/output
MINERU_BACKEND=pipeline
MINERU_PARSE_METHOD=auto
MINERU_LANG=ch
MINERU_TIMEOUT=1800
MINERU_FORMULA_ENABLE=true
MINERU_TABLE_ENABLE=true

# ai-service MinerU 配置（可选）
MINERU_ENABLED=true               # 是否启用 MinerU
MINERU_PAGES_PER_CHUNK=8          # 每个 PDF 块的页数
MINERU_CACHE_TTL_DAYS=30          # 缓存有效期 (天)

# ========== vLLM Embedding 配置 ==========
VLLM_EMBEDDING_BASE_URL=http://192.168.8.233:8092/v1
VLLM_EMBEDDING_MODEL=BAAI/bge-m3
VLLM_API_KEY=not-needed

# ========== 多模态模型配置（Qwen2-VL 图片描述）==========
QWEN_VL_MODEL=qwen2-vl:latest
QWEN_VL_BASE_URL=http://192.168.8.233:11434
ENABLE_IMAGE_DESCRIPTION=false

# ========== ChromaDB 配置 ==========
CHROMA_COLLECTION_NAME=rag_documents
CHROMA_USE_REMOTE=true

# ========== MongoDB DocStore 配置 ==========
DOCSTORE_COLLECTION=llamarag_docstore

# ========== 索引配置 ==========
CHUNK_SIZE=512
CHUNK_OVERLAP=150
TOP_K=5
SIMILARITY_THRESHOLD=0.6

# ========== Reranker 配置 ==========
RERANK_MODEL=bge-reranker-m3
RERANK_BASE_URL=http://192.168.8.233:8091
RERANK_TIMEOUT=120
RERANK_CANDIDATE_MULTIPLIER=4

# ========== 查询扩展配置 ==========
QUERY_EXPANSION_ENABLED=true
QUERY_EXPANSION_MAX_EXPANSIONS=3

# ========== LLM 配置（用于查询扩展）==========
LLM_PROVIDER=ollama
LLM_BASE_URL=http://192.168.8.230:11434
LLM_MODEL=qwen2.5:14b
LLM_API_KEY=not-needed
LLM_TIMEOUT=60

# ========== 文档摘要配置 ==========
ENABLE_SUMMARIZATION=true
SUMMARIZATION_MIN_LENGTH=256
SUMMARIZATION_CONCURRENT=5

# ========== 日志配置 ==========
LOG_FILE=logs/rag_sdk.log

# ------------------------------------------------------------------------------
# ElasticSearch Configuration (全文检索)
# ------------------------------------------------------------------------------
# WSL+Ubuntu22.04 开发环境 - 使用 Docker Compose 端口映射
# 容器外部用
ES_HOST=192.168.8.234
# 容器内部用
# ES_HOST=elasticsearch
ES_PORT=9200
# es索引的开头， 后面接： `_faq`、`_doc`、`_major`、`_sensitive`
ES_INDEX_PREFIX=digital_employee
ES_USERNAME=
ES_PASSWORD=

# ------------------------------------------------------------------------------
# Service Configuration (服务基础配置)
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8100
API_WORKERS=4
# 现在干扰信息
LOG_LEVEL=INFO
# 参数没生效，我直接代码改了
DEBUG=false

# ------------------------------------------------------------------------------
# Rate Limiting Configuration (访问限流)
# ------------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60          # 每分钟最大请求数
RATE_LIMIT_PER_SESSION=10         # 每个会话每分钟最大请求数
MAX_CONCURRENT_SESSIONS=100       # 最大并发会话数
RATE_LIMIT_PER_IP_PER_MINUTE=30  # 每个IP每分钟最大请求数 (用于轮询接口)

# ------------------------------------------------------------------------------
# Conversation Configuration (对话配置)
# ------------------------------------------------------------------------------
MAX_CONTEXT_TURNS=10              # 最大上下文轮次
SESSION_TIMEOUT_MINUTES=30        # 会话超时时间 (分钟)
RELEVANCE_THRESHOLD=0.005         # RAG 相关性阈值 (低于此值触发联网搜索)
CONFIDENCE_THRESHOLD=0.7          # 置信度阈值

# ------------------------------------------------------------------------------
# Document Processing Configuration (文档处理)
# ------------------------------------------------------------------------------
# 注意：分块配置已移至 SDK 配置部分 (CHUNK_SIZE=512, CHUNK_OVERLAP=150)
# SDK 统一处理文档索引和检索，ai-service 不再单独管理分块配置
ENABLE_CHUNK_SUMMARY=true         # 是否启用分块摘要

# 摘要生成配置
SUMMARY_MODEL=gpt-4o-mini         # 摘要使用的模型
SUMMARY_MAX_TOKENS=200            # 摘要最大 token 数
SUMMARY_BATCH_SIZE=10             # 批量摘要大小

# 语义切分配置 (推荐启用)
ENABLE_SEMANTIC_CHUNKING=true     # 是否启用语义切分
SEMANTIC_CHUNK_SIMILARITY_THRESHOLD=0.75  # 语义相似度阈值 (越低切分越多)
SEMANTIC_CHUNK_MIN_SIZE=100       # 最小块大小 (字符)
SEMANTIC_CHUNK_MAX_SIZE=500       # 最大块大小 (字符)
SEMANTIC_CHUNK_WINDOW_SIZE=3      # 滑动窗口大小 (句子数)

# 分层摘要配置
ENABLE_HIERARCHICAL_SUMMARY=true  # 是否启用分层摘要
SUMMARY_CHUNK_LEVEL=true          # Chunk 级别摘要 (<=50字)
SUMMARY_SECTION_LEVEL=true        # Section 级别摘要 (>=5块时触发,<=100字)
SUMMARY_DOCUMENT_LEVEL=true       # Document 级别摘要 (>=50块时触发,<=200字)
SUMMARY_SECTION_THRESHOLD=5       # Section 摘要触发阈值 (块数)
SUMMARY_DOCUMENT_THRESHOLD=50     # Document 摘要触发阈值 (块数)

# ------------------------------------------------------------------------------
# Reranker Configuration (重排序配置)
# ------------------------------------------------------------------------------
RERANK_ENABLED=true                 # 是否启用文档重排序
RERANKER_TYPE=ollama                # 重排序器类型: ollama, bge, noop, hybrid
OLLAMA_RERANKER_MODEL=qllama/bge-reranker-v2-m3:latest  # Ollama 重排序模型
RERANKER_MAX_TEXT_LENGTH=200        # 重排序器最大输入文本长度 (字符)
RERANK_TOP_K=10                     # 返回 Top-K 结果

# ------------------------------------------------------------------------------
# JWT Configuration (身份认证)
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# ------------------------------------------------------------------------------
# CORS Configuration (跨域资源共享)
# ------------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=true

# ------------------------------------------------------------------------------
# API Authentication (接口认证)
# ------------------------------------------------------------------------------
# 生产环境请修改此密钥
API_KEY=y2tJW3P0bvZIxw6pGuV2FrcT0C1wyUfg2ldweEaDYN4

# ------------------------------------------------------------------------------
# Graph Debug Configuration (工作流调试)
# ------------------------------------------------------------------------------
CRAG_DUMP_GRAPH=1                  # 启用图结构导出 (1=启用, 0=禁用)
CRAG_RENDER_REMOTE=1              # 禁用远程渲染 (避免 400 错误)
CRAG_GRAPH_DIR=./graph_debug      # 图结构输出目录

# ------------------------------------------------------------------------------
# External Services (外部服务集成)
# ------------------------------------------------------------------------------
# Java 平台员工 API 地址
EXTERNAL_EMPLOYEE_API_URL=http://192.168.9.39/edu-api/avatar/api/digitalEmployee/get

# 测试文件目录 (用于文档上传测试)
TEST_FILES_DIR=./test_files

# ------------------------------------------------------------------------------
# Ollama Keep-Alive Configuration (模型保活)
# ------------------------------------------------------------------------------
# 防止 Ollama 模型在空闲时被卸载 (单位: 秒)
# -1 表示永不卸载, 0 表示禁用保活
OLLAMA_KEEP_ALIVE_INTERVAL=180

# ------------------------------------------------------------------------------
# Logging Configuration (日志)
# ------------------------------------------------------------------------------
# 文件日志特性:
# - 自动轮转: 单文件达到 100MB 时自动切割
# - 保留期限: 保留 30 天的日志
# - 压缩: 老日志自动压缩为 zip 格式
# - 异步写入: 使用队列异步写入,不影响性能
LOG_FILE=logs/ai-service.log
