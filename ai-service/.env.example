# LLM Configuration
OPENAI_API_KEY=sk-xxx
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000

# Web Search Configuration
TAVILY_API_KEY=tvly-xxx
WEB_SEARCH_ENABLED=true
WEB_SEARCH_TIMEOUT=5
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_ONLY_FOR_REALTIME=false
REALTIME_QUERY_ENABLED=true
REALTIME_QUERY_LLM_FALLBACK_ENABLED=false

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/digital_employee
MONGODB_DB_NAME=digital_employee
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=10

# Chroma Configuration
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIR=/app/chroma_db

# ElasticSearch Configuration
ES_HOST=localhost
ES_PORT=9200
ES_INDEX_PREFIX=digital_employee
ES_USERNAME=
ES_PASSWORD=

# Java Platform API Configuration
JAVA_API_BASE_URL=http://java-platform:8080
JAVA_API_KEY=xxx
JAVA_API_TIMEOUT=10

# Service Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
LOG_LEVEL=INFO
DEBUG=false

# Rate Limiting Configuration
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_SESSION=10
MAX_CONCURRENT_SESSIONS=100

# Conversation Configuration
MAX_CONTEXT_TURNS=10
SESSION_TIMEOUT_MINUTES=30
RELEVANCE_THRESHOLD=0.6
CONFIDENCE_THRESHOLD=0.7

# Document Processing Configuration
CHUNK_SIZE=512
CHUNK_OVERLAP=50
ENABLE_CHUNK_SUMMARY=true
SUMMARY_MODEL=gpt-4o-mini
SUMMARY_MAX_TOKENS=200
SUMMARY_BATCH_SIZE=10

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true
