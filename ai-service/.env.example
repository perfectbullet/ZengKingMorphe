# LLM Configuration
USE_OLLAMA=false

# Ollama Configuration (used when USE_OLLAMA=true)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_GRADER_MODEL=qwen2.5:7b

# OpenAI-style API Configuration (used when USE_OLLAMA=false)
# For SiliconFlow, use: https://api.siliconflow.cn/v1
OPENAI_API_KEY=sk-xxx
OPENAI_API_BASE=https://api.siliconflow.cn/v1
OPENAI_MODEL=deepseek-ai/DeepSeek-V3.1-Terminus
OPENAI_GRADER_MODEL=deepseek-ai/DeepSeek-V3
OPENAI_TEMPERATURE=0.0
OPENAI_MAX_TOKENS=2000

# Embedding Configuration (Ollama)
EMBEDDING_OLLAMA_MODEL=smartcreation/bge-large-zh-v1.5:latest
# Embedding will use the same OLLAMA_BASE_URL as LLM

# SiliconFlow API (for LLM, not embedding)
SILICONFLOW_API_KEY=

# Web Search Configuration
TAVILY_API_KEY=tvly-xxx
WEB_SEARCH_ENABLED=true
WEB_SEARCH_TIMEOUT=5
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_ONLY_FOR_REALTIME=false
REALTIME_QUERY_ENABLED=true
REALTIME_QUERY_LLM_FALLBACK_ENABLED=false

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/digital_employee
MONGODB_DB_NAME=digital_employee
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=10

# Chroma Configuration
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_PERSIST_DIR=/app/chroma_db

# ElasticSearch Configuration
ES_HOST=localhost
ES_PORT=9200
ES_INDEX_PREFIX=digital_employee
ES_USERNAME=
ES_PASSWORD=

# Java Platform API Configuration
JAVA_API_BASE_URL=http://java-platform:8080
JAVA_API_KEY=xxx
JAVA_API_TIMEOUT=10

# Service Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
LOG_LEVEL=INFO
DEBUG=false

# Rate Limiting Configuration
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_SESSION=10
MAX_CONCURRENT_SESSIONS=100
RATE_LIMIT_PER_IP_PER_MINUTE=30

# Conversation Configuration
MAX_CONTEXT_TURNS=10
SESSION_TIMEOUT_MINUTES=30
RELEVANCE_THRESHOLD=0.6
CONFIDENCE_THRESHOLD=0.7

# Document Processing Configuration
CHUNK_SIZE=512
CHUNK_OVERLAP=50
ENABLE_CHUNK_SUMMARY=true
SUMMARY_MODEL=gpt-4o-mini
SUMMARY_MAX_TOKENS=200
SUMMARY_BATCH_SIZE=10

# API Key Configuration
# JSON array format for list of valid API keys
API_KEYS='["your-api-key-1","your-api-key-2"]'

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true
